{"content":"<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>アプリ開発アイデア提案 2026 — ケ開発</title>\n<style>\n/* ──────────────────────────────────────────────────────\n   Design Tokens  (Warm Minimalist — portal / portfolio)\n────────────────────────────────────────────────────── */\n:root {\n  --bg:          #F8F5F1;\n  --bg-card:     #FDFAF7;\n  --bg-muted:    #F2EDE8;\n  --fg:          #2C2C2C;\n  --fg-muted:    #6B6560;\n  --border:      #E5DDD6;\n  --accent:      #C45E3E;\n  --accent-soft: #F5E1D6;\n  --green:       #4A7C6F;\n  --green-soft:  #E6F0EE;\n  --yellow:      #8A6A2E;\n  --yellow-soft: #F5EDD6;\n  --blue:        #3A5F8A;\n  --blue-soft:   #DDE8F5;\n  --font-sans:   'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Segoe UI', system-ui, sans-serif;\n  --font-serif:  'Hiragino Mincho ProN', 'Yu Mincho', Georgia, serif;\n  --font-mono:   'Fira Code', 'Geist Mono', monospace;\n}\n\n*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\nhtml, body {\n  height: 100%;\n  font-family: var(--font-sans);\n  background: var(--bg);\n  color: var(--fg);\n  overflow: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* ── Slide Engine ── */\n.deck { width: 100%; height: 100vh; position: relative; }\n.slide {\n  position: absolute; inset: 0;\n  display: none; flex-direction: column;\n  justify-content: center; align-items: center;\n  padding: 56px 72px; overflow: hidden;\n}\n.slide.active { display: flex; }\n.slide::after {\n  content: '';\n  position: absolute; inset: 0;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n  opacity: 0.025; pointer-events: none;\n}\n\n/* ── Nav ── */\n#nav {\n  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);\n  display: flex; align-items: center; gap: 14px; z-index: 200;\n  background: var(--bg-card); border: 1px solid var(--border);\n  border-radius: 40px; padding: 9px 20px;\n  box-shadow: 0 4px 24px rgba(196,94,62,0.06);\n}\n#nav button {\n  background: none; border: none; color: var(--fg-muted);\n  cursor: pointer; font-size: 16px; padding: 4px 10px;\n  border-radius: 20px; transition: all 0.15s;\n}\n#nav button:hover { background: var(--bg-muted); color: var(--fg); }\n#counter { color: var(--fg-muted); font-size: 12px; min-width: 44px; text-align: center; font-family: var(--font-mono); }\n.dot-row { display: flex; gap: 5px; }\n.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--border); cursor: pointer; transition: all 0.2s; }\n.dot.active { background: var(--accent); transform: scale(1.4); }\n\n/* ── Typography ── */\n.mono-label {\n  font-family: var(--font-mono); font-size: 11px; font-weight: 600;\n  letter-spacing: 0.15em; text-transform: uppercase;\n  color: var(--accent); margin-bottom: 14px;\n}\nh1 {\n  font-family: var(--font-serif); font-size: clamp(36px, 5.5vw, 68px);\n  font-weight: 500; line-height: 1.1; letter-spacing: -0.02em;\n}\nh2 {\n  font-family: var(--font-serif); font-size: clamp(26px, 3.8vw, 46px);\n  font-weight: 500; line-height: 1.15; letter-spacing: -0.02em;\n}\nh3 { font-size: 18px; font-weight: 600; line-height: 1.3; }\n.sub { font-size: clamp(14px, 1.6vw, 17px); color: var(--fg-muted); line-height: 1.75; margin-top: 14px; }\n.accent-text { color: var(--accent); }\n.center { text-align: center; }\n.full { width: 100%; }\n\n/* ── Layout ── */\n.row { display: flex; gap: 24px; width: 100%; }\n.col { flex: 1; }\n.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; width: 100%; }\n.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; width: 100%; }\n\n/* ── Components ── */\n.card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 22px; }\n.card-sm { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 13px 17px; }\n.stat-box {\n  background: var(--bg-card); border: 1px solid var(--border);\n  border-radius: 14px; padding: 20px 22px; text-align: center;\n}\n.stat-num {\n  font-family: var(--font-serif); font-size: clamp(28px, 4vw, 50px);\n  font-weight: 500; line-height: 1; color: var(--accent);\n}\n.stat-label { font-size: 11px; color: var(--fg-muted); margin-top: 7px; letter-spacing: 0.3px; }\n.tag {\n  display: inline-block; padding: 3px 11px; border-radius: 20px;\n  font-size: 11px; font-weight: 600; background: var(--accent-soft);\n  color: var(--accent); border: 1px solid var(--border);\n}\n.tag.green  { background: var(--green-soft);  color: var(--green);  }\n.tag.yellow { background: var(--yellow-soft); color: var(--yellow); }\n.tag.blue   { background: var(--blue-soft);   color: var(--blue);   }\n.feature-list { list-style: none; display: flex; flex-direction: column; gap: 9px; }\n.feature-list li {\n  display: flex; align-items: flex-start; gap: 10px;\n  font-size: 13px; color: var(--fg-muted); line-height: 1.6;\n}\n.feature-list li::before { content: '—'; color: var(--accent); font-weight: 700; flex-shrink: 0; }\n.divider { width: 36px; height: 2px; background: var(--accent); border-radius: 1px; margin: 16px 0; }\n\n/* ── Table ── */\ntable { width: 100%; border-collapse: collapse; font-size: 13px; }\nth {\n  text-align: left; padding: 10px 14px;\n  color: var(--fg-muted); font-size: 11px; font-weight: 600;\n  letter-spacing: 0.1em; text-transform: uppercase;\n  border-bottom: 1px solid var(--border); background: var(--bg-muted);\n}\ntd { padding: 11px 14px; border-bottom: 1px solid var(--border); }\ntr:last-child td { border-bottom: none; }\ntr:hover td { background: var(--accent-soft); }\n\n/* ── Score dots ── */\n.score { display: inline-flex; gap: 4px; align-items: center; }\n.score span { width: 9px; height: 9px; border-radius: 50%; background: var(--border); }\n.score span.on { background: var(--accent); }\n\n/* ── App Icon ── */\n.app-icon {\n  width: 60px; height: 60px; border-radius: 16px;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 28px; flex-shrink: 0;\n}\n\n/* ── Phone Mockup ── */\n.phone {\n  width: 172px; height: 330px; background: var(--bg-muted);\n  border-radius: 30px; border: 1.5px solid var(--border);\n  padding: 14px 10px 10px; position: relative; flex-shrink: 0;\n  box-shadow: 0 16px 48px rgba(44,44,44,0.1);\n}\n.phone::before {\n  content: ''; position: absolute; top: 7px; left: 50%; transform: translateX(-50%);\n  width: 42px; height: 4px; background: var(--border); border-radius: 2px;\n}\n.phone-screen {\n  background: white; border-radius: 20px; height: 100%;\n  overflow: hidden; padding: 20px 10px 10px;\n  display: flex; flex-direction: column; gap: 7px;\n}\n.ph-bar { height: 6px; border-radius: 3px; background: var(--bg-muted); }\n.ph-accent { background: var(--accent); opacity: 0.5; }\n.ph-card {\n  background: var(--bg-card); border: 1px solid var(--border);\n  border-radius: 8px; padding: 8px; display: flex; flex-direction: column; gap: 4px;\n}\n.ph-label { font-size: 8px; font-weight: 600; color: var(--accent); }\n\n/* ── Animations ── */\n.slide.active .anim { animation: fadeUp 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both; }\n@keyframes fadeUp {\n  from { opacity: 0; transform: translateY(14px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n.d1{animation-delay:0.05s!important} .d2{animation-delay:0.10s!important}\n.d3{animation-delay:0.15s!important} .d4{animation-delay:0.20s!important}\n.d5{animation-delay:0.25s!important}\n\n/* ── Title slide decoration ── */\n#s-title::before {\n  content: '';\n  position: absolute; top: -100px; right: -100px;\n  width: 480px; height: 480px; border-radius: 50%;\n  background: radial-gradient(circle, rgba(196,94,62,0.08) 0%, transparent 70%);\n  pointer-events: none;\n}\n</style>\n</head>\n<body>\n<div class=\"deck\">\n\n  <!-- ── 0: Title ── -->\n  <div class=\"slide\" id=\"s-title\">\n    <div class=\"center\" style=\"max-width: 680px;\">\n      <div class=\"mono-label anim\">ケ開発 — 2026年6月</div>\n      <h1 class=\"anim d1\">次の一手、<br><span class=\"accent-text\">5つのアプリ案</span></h1>\n      <p class=\"sub anim d2\">\n        市場トレンド・ダウンロード動向・ユーザーの声を元に<br>\n        マーケットの需要を踏まえた開発アイデアを提案します。\n      </p>\n      <div style=\"margin-top: 30px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;\" class=\"anim d3\">\n        <span class=\"tag\">テクノロジートレンド</span>\n        <span class=\"tag green\">ダウンロード動向</span>\n        <span class=\"tag blue\">ユーザーの声</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- ── 1: Market Overview ── -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 900px;\">\n      <div class=\"mono-label anim\">Research</div>\n      <h2 class=\"anim d1\">市場は今、<span class=\"accent-text\">どこへ向かっているか</span></h2>\n      <div class=\"grid-3\" style=\"margin-top: 28px;\">\n        <div class=\"stat-box anim d2\">\n          <div class=\"stat-num\">$10B+</div>\n          <div class=\"stat-label\">生成AI アプリ市場規模<br>2026年推定</div>\n        </div>\n        <div class=\"stat-box anim d3\">\n          <div class=\"stat-num\">3.8B</div>\n          <div class=\"stat-label\">AI アプリ総DL数<br>前年比 2倍</div>\n        </div>\n        <div class=\"stat-box anim d4\">\n          <div class=\"stat-num\">$11.3B</div>\n          <div class=\"stat-label\">ショートドラマ市場規模<br>2026年初頭</div>\n        </div>\n      </div>\n      <div class=\"grid-2\" style=\"margin-top: 18px;\">\n        <div class=\"card anim d3\">\n          <h3 style=\"margin-bottom: 12px;\">📱 2026年 最多DL TOP5</h3>\n          <ul class=\"feature-list\">\n            <li>ChatGPT — 5590万DL（1月単月、世界1位）</li>\n            <li>TikTok — 4310万DL（ショート動画独走）</li>\n            <li>DramaBox / ReelShort — ショートドラマ系が急伸</li>\n            <li>Google Gemini — AI系アプリが上位を席巻</li>\n            <li>フィットネス・健康系 — ニッチ特化型が安定成長</li>\n          </ul>\n        </div>\n        <div class=\"card anim d4\">\n          <h3 style=\"margin-bottom: 12px;\">💡 個人開発で稼げるカテゴリ</h3>\n          <ul class=\"feature-list\">\n            <li>ADHD・メンタルヘルス特化 → 月$5–15k MRR</li>\n            <li>AI生産性ツール（職種特化型）→ 高い継続課金率</li>\n            <li>語学学習AIツール → 日本では特需あり</li>\n            <li>汎用より「誰のため」が明確なものが勝つ</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ── 2: 3 Axes ── -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 920px;\">\n      <div class=\"mono-label anim\">Market Analysis</div>\n      <h2 class=\"anim d1\">3つの視点から<span class=\"accent-text\">需要を読む</span></h2>\n      <div class=\"grid-3\" style=\"margin-top: 28px;\">\n        <div class=\"card anim d2\">\n          <div style=\"font-size: 24px; margin-bottom: 10px;\">🔬</div>\n          <h3 style=\"margin-bottom: 12px;\">テクノロジートレンド</h3>\n          <ul class=\"feature-list\">\n            <li>AI-first 設計が標準化。70%のアプリがAI機能搭載</li>\n            <li>パーソナライゼーションが「あって当然」の時代に</li>\n            <li>小チームでもMVP開発が数週間に短縮</li>\n          </ul>\n        </div>\n        <div class=\"card anim d3\">\n          <div style=\"font-size: 24px; margin-bottom: 10px;\">📈</div>\n          <h3 style=\"margin-bottom: 12px;\">ダウンロード動向</h3>\n          <ul class=\"feature-list\">\n            <li>AI系アプリDLが前年比2倍（38億DL）</li>\n            <li>全体DLは横ばい → 「選ばれる」難易度が上昇</li>\n            <li>課金意欲が高い健康・学習系が収益力で優位</li>\n          </ul>\n        </div>\n        <div class=\"card anim d4\">\n          <div style=\"font-size: 24px; margin-bottom: 10px;\">🗣️</div>\n          <h3 style=\"margin-bottom: 12px;\">ユーザーの声</h3>\n          <ul class=\"feature-list\">\n            <li>「自分に合ったAI」を求める声が増加</li>\n            <li>ADHD・睡眠・メンタル系のニッチ需要が顕在化</li>\n            <li>英語の「実践練習の場がない」という不満</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"card-sm anim d5\" style=\"margin-top: 16px; border-color: var(--accent-soft);\">\n        <span style=\"color: var(--accent); font-weight: 600;\">結論：</span>\n        <span style=\"color: var(--fg-muted); font-size: 13px;\">「AI × ニッチ特化 × 日本語」の掛け合わせに最も大きなチャンスがある。汎用ツールは大企業に任せ、ケ開発はターゲットを絞った課題解決に集中すべき。</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- ── 3: App 1 ── -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 960px;\">\n      <div class=\"mono-label anim\">Idea 01 / 05</div>\n      <div class=\"row\" style=\"align-items: flex-start; gap: 44px;\">\n        <div class=\"col anim d1\">\n          <div style=\"display: flex; align-items: center; gap: 16px; margin-bottom: 18px;\">\n            <div class=\"app-icon\" style=\"background: var(--accent-soft);\">📔</div>\n            <div>\n              <div style=\"font-size: 24px; font-weight: 700; font-family: var(--font-serif);\">ひと言ログ</div>\n              <div style=\"font-size: 13px; color: var(--fg-muted); margin-top: 3px;\">AI感情日記 — 1日3行で心を可視化</div>\n            </div>\n          </div>\n          <div style=\"display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 18px;\">\n            <span class=\"tag\">メンタルヘルス</span>\n            <span class=\"tag green\">AI分析</span>\n          </div>\n          <ul class=\"feature-list\" style=\"margin-bottom: 18px;\">\n            <li>1日1〜3行を書くだけ。入力ハードルを極限まで下げる</li>\n            <li>AIが感情・ストレス要因をリアルタイム分析・タグ付け</li>\n            <li>週次レポートで「気分のクセ」を可視化</li>\n            <li>「最近ずっと疲れてない？」とAIから先回り通知</li>\n            <li>過去記事を要約して「1年前の自分」と対話できる機能</li>\n          </ul>\n          <div style=\"display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px;\">\n            <span class=\"tag green\">¥480/月 サブスク</span>\n            <span class=\"tag blue\">20-35歳 都市部会社員</span>\n          </div>\n          <div class=\"card-sm\" style=\"border-color: var(--green-soft);\">\n            <div style=\"font-size: 11px; color: var(--green); font-weight: 600; margin-bottom: 4px;\">なぜ今か</div>\n            <div style=\"font-size: 12px; color: var(--fg-muted);\">メンタルヘルス系アプリは課金継続率が高く、日本語特化の競合は少ない。AI分析による差別化で既存の日記アプリからの乗り換えを狙える。</div>\n          </div>\n        </div>\n        <div class=\"anim d2\" style=\"flex-shrink: 0;\">\n          <div class=\"phone\">\n            <div class=\"phone-screen\">\n              <div style=\"font-size: 8px; color: var(--fg-muted);\">2026年6月1日 日曜</div>\n              <div class=\"ph-bar ph-accent\" style=\"width: 65%;\"></div>\n              <div class=\"ph-card\">\n                <div class=\"ph-label\">📝 今日のひと言</div>\n                <div style=\"height: 26px; background: var(--bg); border-radius: 4px; border: 1px solid var(--border);\"></div>\n              </div>\n              <div class=\"ph-card\">\n                <div class=\"ph-label\">📊 今週の感情グラフ</div>\n                <div style=\"display: flex; align-items: flex-end; gap: 3px; height: 28px;\">\n                  <div style=\"flex:1; background: var(--accent-soft); border-radius: 2px; height: 40%;\"></div>\n                  <div style=\"flex:1; background: var(--accent-soft); border-radius: 2px; height: 70%;\"></div>\n                  <div style=\"flex:1; background: var(--accent-soft); border-radius: 2px; height: 50%;\"></div>\n                  <div style=\"flex:1; background: var(--accent-soft); border-radius: 2px; height: 90%;\"></div>\n                  <div style=\"flex:1; background: var(--accent-soft); border-radius: 2px; height: 60%;\"></div>\n                  <div style=\"flex:1; background: var(--accent); opacity: 0.6; border-radius: 2px; height: 85%;\"></div>\n                  <div style=\"flex:1; background: var(--accent); opacity: 0.8; border-radius: 2px; height: 95%;\"></div>\n                </div>\n              </div>\n              <div class=\"ph-card\">\n                <div class=\"ph-label\">🤖 AIより</div>\n                <div class=\"ph-bar\" style=\"width: 90%; margin: 2px 0;\"></div>\n                <div class=\"ph-bar\" style=\"width: 65%;\"></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ── 4: App 2 ── -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 960px;\">\n      <div class=\"mono-label anim\">Idea 02 / 05</div>\n      <div class=\"row\" style=\"align-items: flex-start; gap: 44px;\">\n        <div class=\"col anim d1\">\n          <div style=\"display: flex; align-items: center; gap: 16px; margin-bottom: 18px;\">\n            <div class=\"app-icon\" style=\"background: var(--green-soft);\">⚡</div>\n            <div>\n              <div style=\"font-size: 24px; font-weight: 700; font-family: var(--font-serif);\">フォーカス for ADHD</div>\n              <div style=\"font-size: 13px; color: var(--fg-muted); margin-top: 3px;\">ADHD脳専用の集中サポートアプリ</div>\n            </div>\n          </div>\n          <div style=\"display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 18px;\">\n            <span class=\"tag green\">ADHD特化</span>\n            <span class=\"tag\">生産性</span>\n          </div>\n          <ul class=\"feature-list\" style=\"margin-bottom: 18px;\">\n            <li>「25分だと長すぎる」ADHD向けに5〜15分の超短ポモドーロ</li>\n            <li>AI ボディダブリング — バーチャル作業仲間がセッションを管理</li>\n            <li>タスク分解AI — 「仕事する」を細かなアクションに自動分割</li>\n            <li>過集中タイマー — 気づいたら数時間経過を防ぐ強制休憩</li>\n            <li>達成をポジティブに可視化、未達は見えにくくするUX設計</li>\n          </ul>\n          <div style=\"display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px;\">\n            <span class=\"tag green\">¥680/月（無料プランあり）</span>\n            <span class=\"tag\">ADHD診断・グレーゾーン層</span>\n          </div>\n          <div class=\"card-sm\" style=\"border-color: var(--green-soft);\">\n            <div style=\"font-size: 11px; color: var(--green); font-weight: 600; margin-bottom: 4px;\">なぜ今か</div>\n            <div style=\"font-size: 12px; color: var(--fg-muted);\">ADHD特化アプリは全世界で競合10社未満、月4万件の検索がある。日本語対応の本格的アプリはほぼ皆無。ADHD診断数は増加傾向で課金継続率も高い。</div>\n          </div>\n        </div>\n        <div class=\"anim d2\" style=\"flex-shrink: 0;\">\n          <div class=\"phone\">\n            <div class=\"phone-screen\">\n              <div style=\"font-size: 8px; color: var(--green); font-weight: 600;\">⚡ 集中モード中</div>\n              <div style=\"text-align: center; margin: 4px 0;\">\n                <div style=\"font-size: 26px; font-weight: 700; font-family: var(--font-serif); color: var(--green);\">08:42</div>\n                <div style=\"font-size: 7px; color: var(--fg-muted);\">残り時間</div>\n              </div>\n              <div style=\"height: 5px; background: var(--border); border-radius: 3px; overflow: hidden; margin-bottom: 8px;\">\n                <div style=\"width: 65%; height: 100%; background: var(--green); opacity: 0.7; border-radius: 3px;\"></div>\n              </div>\n              <div class=\"ph-card\" style=\"margin-bottom: 5px;\">\n                <div class=\"ph-label\" style=\"color: var(--green);\">📋 今のタスク</div>\n                <div class=\"ph-bar\" style=\"width: 80%; margin: 2px 0;\"></div>\n                <div class=\"ph-bar\" style=\"width: 50%;\"></div>\n              </div>\n              <div class=\"ph-card\">\n                <div class=\"ph-label\" style=\"color: var(--green);\">🤝 AIバディ</div>\n                <div class=\"ph-bar\" style=\"width: 90%; margin: 2px 0;\"></div>\n                <div class=\"ph-bar\" style=\"width: 65%;\"></div>\n              </div>\n              <div style=\"margin-top: 8px; display: flex; gap: 4px;\">\n                <div style=\"flex:1; background: var(--green-soft); border-radius: 6px; height: 22px; display: flex; align-items: center; justify-content: center; font-size: 7px; color: var(--green);\">一時停止</div>\n                <div style=\"flex:1; background: var(--bg-muted); border-radius: 6px; height: 22px; display: flex; align-items: center; justify-content: center; font-size: 7px; color: var(--fg-muted);\">終了</div>\n              </div>\n            <