{"content":"<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<!--\n  ケ開発 スライドテンプレート\n  ─────────────────────────────────────────────────────────────────\n  カラーパレット: portal / portfolio サイトの Warm Minimalist を踏襲\n\n  使い方:\n  1. このファイルをコピーして documents/proposals/ または documents/specs/ に保存\n  2. <title> を変更\n  3. 各 .slide の中身を書き換える\n  4. スライドが足りなければ既存の .slide ブロックをコピー&ペースト\n  5. 不要なスライドは削除（#nav の dots は JS が自動生成するので触らなくてよい）\n\n  スライドの種類（コメントで例示してある）:\n    slide-title       — タイトルスライド（ファーストビュー）\n    slide-section     — セクション区切り\n    slide-content     — テキスト中心\n    slide-two-col     — 2カラム\n    slide-three-col   — 3カラム（比較・特徴列挙）\n    slide-data        — 数値・KPI 強調\n    slide-table       — テーブル\n    slide-closing     — クロージング\n\n  キーボード: ← → / Space で操作\n  タッチ: スワイプで操作\n  ─────────────────────────────────────────────────────────────────\n-->\n<title>タイトル — ケ開発</title>\n<style>\n/* ──────────────────────────────────────────────────────\n   Design Tokens  (portal / portfolio Warm Minimalist)\n────────────────────────────────────────────────────── */\n:root {\n  /* Core palette */\n  --bg:          #F8F5F1;   /* Warm Alabaster */\n  --bg-card:     #FDFAF7;   /* Card surface */\n  --bg-muted:    #F2EDE8;   /* Muted / chip bg */\n  --fg:          #2C2C2C;   /* Soft Charcoal */\n  --fg-muted:    #6B6560;   /* Secondary text */\n  --border:      #E5DDD6;   /* Warm border */\n  --accent:      #C45E3E;   /* Terracotta (portal) */\n  --accent-soft: #F5E1D6;   /* Terracotta tint */\n\n  /* Semantic helpers */\n  --green:       #4A7C6F;\n  --green-soft:  #E6F0EE;\n  --yellow:      #8A6A2E;\n  --yellow-soft: #F5EDD6;\n  --blue:        #3A5F8A;\n  --blue-soft:   #DDE8F5;\n  --red:         #9A3030;\n  --red-soft:    #F5DEDE;\n\n  /* Typography */\n  --font-sans:   'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Segoe UI', system-ui, sans-serif;\n  --font-serif:  'Hiragino Mincho ProN', 'Yu Mincho', Georgia, serif;\n  --font-mono:   'Fira Code', 'Geist Mono', monospace;\n}\n\n/* ──────────────────────────────────────────────────────\n   Reset & Base\n────────────────────────────────────────────────────── */\n*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\nhtml, body {\n  height: 100%;\n  font-family: var(--font-sans);\n  background: var(--bg);\n  color: var(--fg);\n  overflow: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* ──────────────────────────────────────────────────────\n   Slide Engine\n────────────────────────────────────────────────────── */\n.deck { width: 100%; height: 100vh; position: relative; }\n\n.slide {\n  position: absolute; inset: 0;\n  display: none;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  padding: 56px 72px;\n  overflow: hidden;\n}\n.slide.active { display: flex; }\n\n/* Paper texture overlay (matches portfolio) */\n.slide::after {\n  content: '';\n  position: absolute; inset: 0;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n  opacity: 0.025;\n  pointer-events: none;\n}\n\n/* ──────────────────────────────────────────────────────\n   Navigation Bar\n────────────────────────────────────────────────────── */\n#nav {\n  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);\n  display: flex; align-items: center; gap: 14px; z-index: 200;\n  background: var(--bg-card); border: 1px solid var(--border);\n  border-radius: 40px; padding: 9px 20px;\n  box-shadow: 0 4px 24px rgba(196,94,62,0.06);\n}\n#nav button {\n  background: none; border: none; color: var(--fg-muted);\n  cursor: pointer; font-size: 16px; padding: 4px 10px;\n  border-radius: 20px; transition: all 0.15s; font-family: var(--font-sans);\n}\n#nav button:hover { background: var(--bg-muted); color: var(--fg); }\n#counter { color: var(--fg-muted); font-size: 12px; min-width: 44px; text-align: center; font-family: var(--font-mono); }\n.dot-row { display: flex; gap: 5px; }\n.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--border); cursor: pointer; transition: all 0.2s; }\n.dot.active { background: var(--accent); transform: scale(1.4); }\n\n/* ──────────────────────────────────────────────────────\n   Typography\n────────────────────────────────────────────────────── */\n.mono-label {\n  font-family: var(--font-mono);\n  font-size: 11px; font-weight: 600;\n  letter-spacing: 0.15em; text-transform: uppercase;\n  color: var(--accent); margin-bottom: 14px;\n}\n\nh1 {\n  font-family: var(--font-serif);\n  font-size: clamp(36px, 5.5vw, 68px);\n  font-weight: 500; line-height: 1.1; letter-spacing: -0.02em;\n  color: var(--fg);\n}\nh2 {\n  font-family: var(--font-serif);\n  font-size: clamp(26px, 3.8vw, 48px);\n  font-weight: 500; line-height: 1.15; letter-spacing: -0.02em;\n  color: var(--fg);\n}\nh3 {\n  font-size: 18px; font-weight: 600;\n  color: var(--fg); line-height: 1.3;\n}\n.sub {\n  font-size: clamp(14px, 1.6vw, 17px);\n  color: var(--fg-muted); line-height: 1.75; margin-top: 14px;\n}\n.accent-text { color: var(--accent); }\n.muted      { color: var(--fg-muted); }\n.center     { text-align: center; }\n.full       { width: 100%; }\n\n/* ──────────────────────────────────────────────────────\n   Layout\n────────────────────────────────────────────────────── */\n.row   { display: flex; gap: 24px; width: 100%; }\n.col   { flex: 1; }\n.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; width: 100%; }\n.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; width: 100%; }\n\n/* ──────────────────────────────────────────────────────\n   Components\n────────────────────────────────────────────────────── */\n\n/* Card */\n.card {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 16px; padding: 24px;\n}\n.card-sm {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 12px; padding: 14px 18px;\n}\n\n/* Stat / KPI box */\n.stat-box {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 14px; padding: 22px 24px; text-align: center;\n}\n.stat-num {\n  font-family: var(--font-serif);\n  font-size: clamp(30px, 4.5vw, 52px);\n  font-weight: 500; line-height: 1;\n  color: var(--accent);\n}\n.stat-label { font-size: 12px; color: var(--fg-muted); margin-top: 7px; letter-spacing: 0.5px; }\n\n/* Tag / Badge */\n.tag {\n  display: inline-block; padding: 3px 11px; border-radius: 20px;\n  font-size: 11px; font-weight: 600; letter-spacing: 0.3px;\n  background: var(--accent-soft); color: var(--accent);\n  border: 1px solid var(--border);\n}\n.tag.green  { background: var(--green-soft);  color: var(--green);  }\n.tag.yellow { background: var(--yellow-soft); color: var(--yellow); }\n.tag.blue   { background: var(--blue-soft);   color: var(--blue);   }\n.tag.red    { background: var(--red-soft);    color: var(--red);    }\n\n/* Feature / bullet list */\n.feature-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }\n.feature-list li {\n  display: flex; align-items: flex-start; gap: 10px;\n  font-size: 14px; color: var(--fg-muted); line-height: 1.6;\n}\n.feature-list li::before {\n  content: '—'; color: var(--accent); font-weight: 700; flex-shrink: 0;\n  margin-top: 1px;\n}\n\n/* Divider */\n.divider {\n  width: 40px; height: 2px;\n  background: var(--accent); border-radius: 1px;\n  margin: 18px 0;\n}\n\n/* Progress bar */\n.progress-bar {\n  width: 100%; height: 5px;\n  background: var(--border); border-radius: 3px; overflow: hidden;\n}\n.progress-fill {\n  height: 100%; border-radius: 3px;\n  background: var(--accent);\n}\n\n/* Table */\ntable { width: 100%; border-collapse: collapse; font-size: 13px; }\nth {\n  text-align: left; padding: 10px 14px;\n  color: var(--fg-muted); font-size: 11px; font-weight: 600;\n  letter-spacing: 0.1em; text-transform: uppercase;\n  border-bottom: 1px solid var(--border);\n  background: var(--bg-muted);\n}\ntd { padding: 12px 14px; border-bottom: 1px solid var(--border); font-size: 13px; }\ntr:last-child td { border-bottom: none; }\ntr:hover td { background: var(--accent-soft); }\n\n/* Quote */\nblockquote {\n  border-left: 2px solid var(--accent);\n  padding: 8px 20px;\n  font-family: var(--font-serif);\n  font-style: italic;\n  font-size: clamp(16px, 2vw, 22px);\n  color: var(--fg-muted);\n  line-height: 1.7;\n}\n\n/* ──────────────────────────────────────────────────────\n   Section Header decoration (title slide bg accent)\n────────────────────────────────────────────────────── */\n.slide-title-bg::before {\n  content: '';\n  position: absolute; top: -120px; right: -120px;\n  width: 500px; height: 500px; border-radius: 50%;\n  background: radial-gradient(circle, rgba(196,94,62,0.07) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n/* ──────────────────────────────────────────────────────\n   Animations\n────────────────────────────────────────────────────── */\n.slide.active .anim {\n  animation: fadeInUp 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;\n}\n@keyframes fadeInUp {\n  from { opacity: 0; transform: translateY(14px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n.d1 { animation-delay: 0.05s !important; }\n.d2 { animation-delay: 0.10s !important; }\n.d3 { animation-delay: 0.15s !important; }\n.d4 { animation-delay: 0.20s !important; }\n.d5 { animation-delay: 0.25s !important; }\n</style>\n</head>\n<body>\n\n<div class=\"deck\" id=\"deck\">\n\n  <!-- ══════════════════════════════════════════════════\n       SLIDE TYPE: title  ── ファーストビュー\n  ══════════════════════════════════════════════════ -->\n  <div class=\"slide slide-title-bg active\">\n    <div class=\"center\" style=\"max-width: 680px;\">\n      <div class=\"mono-label anim\">ケ開発 — 2026年6月</div>  <!-- サブタイトル / 日付 -->\n      <h1 class=\"anim d1\">\n        スライドの<span class=\"accent-text\">タイトル</span><br>ここに入れる\n      </h1>\n      <p class=\"sub anim d2\">\n        サブタイトルや背景説明をここに書く。<br>\n        1〜2行程度がちょうどいい。\n      </p>\n      <div style=\"margin-top: 32px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;\" class=\"anim d3\">\n        <span class=\"tag\">タグ1</span>\n        <span class=\"tag green\">タグ2</span>\n        <span class=\"tag blue\">タグ3</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- ══════════════════════════════════════════════════\n       SLIDE TYPE: section  ── セクション区切り\n  ══════════════════════════════════════════════════ -->\n  <div class=\"slide\">\n    <div class=\"center\" style=\"max-width: 560px;\">\n      <div class=\"mono-label anim\">Section 01</div>\n      <h2 class=\"anim d1\">セクション名</h2>\n      <div class=\"divider anim d2\" style=\"margin: 18px auto;\"></div>\n      <p class=\"sub anim d3\">このセクションで伝えたいことの一行要約。</p>\n    </div>\n  </div>\n\n  <!-- ══════════════════════════════════════════════════\n       SLIDE TYPE: data  ── 数値・KPI 強調\n  ══════════════════════════════════════════════════ -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 880px;\">\n      <div class=\"mono-label anim\">Key Numbers</div>\n      <h2 class=\"anim d1\">数字で見る<span class=\"accent-text\">現状</span></h2>\n      <div class=\"grid-3\" style=\"margin-top: 28px;\">\n        <div class=\"stat-box anim d2\">\n          <div class=\"stat-num\">00%</div>\n          <div class=\"stat-label\">指標の名前<br>補足説明</div>\n        </div>\n        <div class=\"stat-box anim d3\">\n          <div class=\"stat-num\">¥0B</div>\n          <div class=\"stat-label\">指標の名前<br>補足説明</div>\n        </div>\n        <div class=\"stat-box anim d4\">\n          <div class=\"stat-num\">0x</div>\n          <div class=\"stat-label\">指標の名前<br>補足説明</div>\n        </div>\n      </div>\n      <div class=\"card-sm anim d5\" style=\"margin-top: 18px;\">\n        <span style=\"color: var(--accent); font-weight: 600;\">ポイント：</span>\n        <span class=\"muted\" style=\"font-size: 14px;\">数字から読み取れる示唆を1〜2行で。</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- ══════════════════════════════════════════════════\n       SLIDE TYPE: two-col  ── 2カラム\n  ══════════════════════════════════════════════════ -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 900px;\">\n      <div class=\"mono-label anim\">比較 / 詳細</div>\n      <h2 class=\"anim d1\">見出しを<span class=\"accent-text\">ここに</span></h2>\n      <div class=\"row\" style=\"margin-top: 28px; align-items: flex-start;\">\n        <div class=\"col anim d2\">\n          <div class=\"card\" style=\"height: 100%;\">\n            <h3 style=\"margin-bottom: 14px;\">左カラムのタイトル</h3>\n            <ul class=\"feature-list\">\n              <li>箇条書きの内容 1</li>\n              <li>箇条書きの内容 2</li>\n              <li>箇条書きの内容 3</li>\n              <li>箇条書きの内容 4</li>\n            </ul>\n          </div>\n        </div>\n        <div class=\"col anim d3\">\n          <div class=\"card\" style=\"height: 100%;\">\n            <h3 style=\"margin-bottom: 14px;\">右カラムのタイトル</h3>\n            <ul class=\"feature-list\">\n              <li>箇条書きの内容 1</li>\n              <li>箇条書きの内容 2</li>\n              <li>箇条書きの内容 3</li>\n              <li>箇条書きの内容 4</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ══════════════════════════════════════════════════\n       SLIDE TYPE: three-col  ── 3カラム\n  ══════════════════════════════════════════════════ -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 920px;\">\n      <div class=\"mono-label anim\">3つの視点</div>\n      <h2 class=\"anim d1\">見出しを<span class=\"accent-text\">ここに</span></h2>\n      <div class=\"grid-3\" style=\"margin-top: 28px;\">\n        <div class=\"card anim d2\">\n          <div style=\"font-size: 24px; margin-bottom: 10px;\">🔬</div>\n          <h3 style=\"margin-bottom: 12px;\">カラム1のタイトル</h3>\n          <ul class=\"feature-list\">\n            <li>ポイント 1</li>\n            <li>ポイント 2</li>\n            <li>ポイント 3</li>\n          </ul>\n        </div>\n        <div class=\"card anim d3\">\n          <div style=\"font-size: 24px; margin-bottom: 10px;\">📈</div>\n          <h3 style=\"margin-bottom: 12px;\">カラム2のタイトル</h3>\n          <ul class=\"feature-list\">\n            <li>ポイント 1</li>\n            <li>ポイント 2</li>\n            <li>ポイント 3</li>\n          </ul>\n        </div>\n        <div class=\"card anim d4\">\n          <div style=\"font-size: 24px; margin-bottom: 10px;\">💡</div>\n          <h3 style=\"margin-bottom: 12px;\">カラム3のタイトル</h3>\n          <ul class=\"feature-list\">\n            <li>ポイント 1</li>\n            <li>ポイント 2</li>\n            <li>ポイント 3</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ══════════════════════════════════════════════════\n       SLIDE TYPE: content  ── テキスト中心・引用\n  ══════════════════════════════════════════════════ -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 760px;\">\n      <div class=\"mono-label anim\">Insight</div>\n      <blockquote class=\"anim d1\">\n        引用やキーメッセージをここに。<br>\n        1〜2文で端的に。\n      </blockquote>\n      <div class=\"divider anim d2\"></div>\n      <ul class=\"feature-list anim d3\">\n        <li>補足説明 1</li>\n        <li>補足説明 2</li>\n        <li>補足説明 3</li>\n      </ul>\n    </div>\n  </div>\n\n  <!-- ══════════════════════════════════════════════════\n       SLIDE TYPE: table  ── テーブル比較\n  ══════════════════════════════════════════════════ -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 900px;\">\n      <div class=\"mono-label anim\">Comparison</div>\n      <h2 class=\"anim d1\">比較<span class=\"accent-text\">テーブル</span></h2>\n      <div class=\"card anim d2\" style=\"margin-top: 24px; padding: 0; overflow: hidden;\">\n        <table>\n          <thead>\n            <tr>\n              <th>項目</th>\n              <th>列 A</th>\n              <th>列 B</th>\n              <th>列 C</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td><strong>行 1</strong></td>\n              <td>値</td>\n              <td>値</td>\n              <td><span class=\"tag green\">推奨</span></td>\n            </tr>\n            <tr>\n              <td><strong>行 2</strong></td>\n              <td>値</td>\n              <td>値</td>\n              <td>値</td>\n            </tr>\n            <tr>\n              <td><strong>行 3</strong></td>\n              <td>値</td>\n              <td>値</td>\n              <td>値</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- ══════════════════════════════════════════════════\n       SLIDE TYPE: closing  ── まとめ・ネクストステップ\n  ══════════════════════════════════════════════════ -->\n  <div class=\"slide\">\n    <div class=\"full\" style=\"max-width: 860px;\">\n      <div class=\"mono-label anim\">Next Steps</div>\n      <h2 class=\"anim d1\">次に<span class=\"accent-text\">やること</span></h2>\n      <div class=\"grid-2\" style=\"margin-top: 28px;\">\n        <div class=\"card anim d2\" style=\"height: 100%;\">\n          <h3 style=\"color: var(--accent); margin-bottom: 14px;\">フェーズ 1</h3>\n          <ul class=\"feature-list\">\n            <li>アクション 1</li>\n            <li>アクション 2</li>\n            <li>アクション 3</li>\n          </ul>\n        </div>\n        <div class=\"card anim d3\" style=\"height: 100%;\">\n          <h3 style=\"color: var(--green); margin-bottom: 14px;\">フェーズ 2</h3>\n          <ul class=\"feature-list\">\n            <li>アクション 1</li>\n            <li>アクション 2</li>\n            <li>アクション 3</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"card-sm anim d4\" style=\"margin-top: 18px; border-color: var(--accent-soft); text-align: center;\">\n        <span class=\"muted\" style=\"font-size: 14px;\">締めの一言・呼びかけ・結論をここに。</span>\n      </div>\n    </div>\n  </div>\n\n</div><!-- /deck -->\n\n<!-- ──────────────────────────────────────────────────────\n     Navigation\n────────────────────────────────────────────────────── -->\n<div id=\"nav\">\n  <button onclick=\"prev()\" title=\"前へ\">←</button>\n  <div class=\"dot-row\" id=\"dots\"></div>\n  <span id=\"counter\">1 / 1</span>\n  <button onclick=\"next()\" title=\"次へ\">→</button>\n</div>\n\n<script>\n  const slides = document.querySelectorAll('.slide');\n  let cur = 0;\n  const dotsEl   = document.getElementById('dots');\n  const counterEl = document.getElementById('counter');\n\n  slides.forEach((_, i) => {\n    const d = document.createElement('div');\n    d.className = 'dot' + (i === 0 ? ' active' : '');\n    d.onclick = () => go(i);\n    dotsEl.appendChild(d);\n  });\n  counterEl.textContent = '1 / ' + slides.length;\n\n  function go(n) {\n    slides[cur].classList.remove('active');\n    dotsEl.children[cur].classList.remove('active');\n    cur = (n + slides.length) % slides.length;\n    slides[cur].classList.add('active');\n    dotsEl.children[cur].classList.add('active');\n    counterEl.textContent = (cur + 1) + ' / ' + slides.length;\n  }\n  function next() { go(cur + 1); }\n  function prev() { go(cur - 1); }\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); next(); }\n    if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }\n  });\n\n  let ts = 0;\n  document.addEventListener('touchstart', e => { ts = e.touches[0].clientX; });\n  document.addEventListener('touchend',   e => {\n    const dx = e.changedTouches[0].clientX - ts;\n    if (Math.abs(dx) > 50) dx < 0 ? next() : prev();\n  });\n</script>\n</body>\n</html>\n"}