{"content":"<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>川上 成長計画書</title>\n<style>\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n:root {\n  --bg: #0d1117; --surface: #161b22; --border: #30363d;\n  --text: #e6edf3; --muted: #7d8590;\n  --accent: #58a6ff; --green: #3fb950; --red: #f85149;\n  --yellow: #d29922; --purple: #bc8cff;\n}\nhtml, body { width: 100%; height: 100%; overflow: hidden; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }\n.deck { width: 100%; height: 100%; position: relative; }\n.slide { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 48px 64px; opacity: 0; pointer-events: none; transition: opacity .4s; }\n.slide.active { opacity: 1; pointer-events: all; }\n#nav { position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 16px; z-index: 100; background: var(--surface); border: 1px solid var(--border); border-radius: 40px; padding: 10px 20px; }\n#nav button { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 18px; line-height: 1; padding: 4px 8px; border-radius: 6px; transition: color .15s, background .15s; }\n#nav button:hover { color: var(--text); background: var(--border); }\n#page-indicator { font-size: 13px; color: var(--muted); min-width: 60px; text-align: center; }\n.slide-title { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 16px; }\nh1 { font-size: 52px; font-weight: 800; line-height: 1.1; }\nh2 { font-size: 36px; font-weight: 700; }\n.accent { color: var(--accent); }\n.green { color: var(--green); }\n.yellow { color: var(--yellow); }\n.purple { color: var(--purple); }\n.muted { color: var(--muted); }\n\n/* S1 Title */\n#s1 { text-align: center; }\n#s1 .badge { display: inline-flex; align-items: center; gap: 8px; background: #1f3a5f; border: 1px solid var(--accent); border-radius: 20px; padding: 6px 16px; font-size: 13px; color: var(--accent); margin-bottom: 32px; }\n#s1 .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: pulse 1.5s infinite; }\n@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }\n#s1 h1 { font-size: 64px; margin-bottom: 12px; }\n#s1 .subtitle { font-size: 20px; color: var(--muted); margin-bottom: 40px; }\n#s1 .meta { display: flex; gap: 32px; justify-content: center; }\n#s1 .meta-item { display: flex; flex-direction: column; align-items: center; gap: 4px; }\n#s1 .meta-value { font-size: 24px; font-weight: 700; }\n#s1 .meta-label { font-size: 12px; color: var(--muted); }\n\n/* S2 Architecture */\n.arch { width: 100%; max-width: 860px; }\n.arch-row { display: flex; justify-content: center; gap: 12px; margin-bottom: 8px; }\n.arch-arrow { display: flex; justify-content: center; align-items: center; height: 28px; font-size: 13px; color: var(--muted); }\n.arch-box { border-radius: 10px; padding: 14px 20px; font-size: 14px; font-weight: 600; display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; min-width: 140px; }\n.arch-box .sub { font-size: 11px; font-weight: 400; color: var(--muted); }\n.ab-user   { background: #1c2a3d; border: 1px solid var(--accent); color: var(--accent); }\n.ab-claude { background: #2a1a0e; border: 1px solid var(--yellow); color: var(--yellow); }\n.ab-fs     { background: #1f2937; border: 1px solid var(--muted); color: var(--text); }\n\n/* S3 Dir Structure */\n.dir-tree { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 28px 36px; font-family: 'SF Mono','Consolas',monospace; font-size: 14px; line-height: 2; width: 100%; max-width: 680px; }\n.dir-tree .d { color: var(--accent); }\n.dir-tree .f { color: var(--text); }\n.dir-tree .c { color: var(--muted); font-size: 12px; }\n.dir-tree .link { color: var(--green); }\n\n/* S4 Usage */\n.flow { width: 100%; max-width: 820px; display: flex; flex-direction: column; gap: 10px; }\n.flow-step { display: flex; align-items: flex-start; gap: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 20px; }\n.flow-num { width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: #0d1117; font-weight: 800; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n.flow-content h3 { font-size: 15px; margin-bottom: 4px; }\n.flow-content p { font-size: 13px; color: var(--muted); line-height: 1.5; }\n.flow-content code { background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: 2px 6px; font-size: 12px; color: var(--accent); font-family: 'SF Mono','Consolas',monospace; }\n\n/* S5 Manual */\n.manual { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; max-width: 900px; }\n.manual-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px; }\n.manual-card h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 14px; }\n.cmd-list { display: flex; flex-direction: column; gap: 8px; }\n.cmd-row { display: flex; flex-direction: column; gap: 2px; }\n.cmd-code { font-family: 'SF Mono','Consolas',monospace; font-size: 13px; color: var(--accent); background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 6px 10px; }\n.cmd-desc { font-size: 12px; color: var(--muted); padding: 0 4px; }\n\n/* S6 Roadmap */\n.roadmap { width: 100%; max-width: 860px; }\n.rm-phase { display: flex; gap: 20px; position: relative; padding-bottom: 8px; }\n.rm-phase:not(:last-child)::after { content: ''; position: absolute; left: 19px; top: 40px; bottom: 0; width: 2px; background: var(--border); }\n.rm-dot { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 800; position: relative; z-index: 1; }\n.rm-dot.active { background: var(--green); color: #0d1117; }\n.rm-dot.next   { background: var(--accent); color: #0d1117; }\n.rm-dot.future { background: var(--surface); border: 2px solid var(--border); color: var(--muted); }\n.rm-body { padding: 8px 0 28px; flex: 1; }\n.rm-body h3 { font-size: 16px; font-weight: 700; margin-bottom: 6px; }\n.rm-tag { font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600; margin-left: 8px; }\n.tag-now    { background: #1d2a1d; color: var(--green); }\n.tag-next   { background: #1c2a3d; color: var(--accent); }\n.tag-future { background: #2a1e2a; color: var(--purple); }\n.rm-body ul { list-style: none; display: flex; flex-direction: column; gap: 6px; margin-top: 8px; }\n.rm-body li { font-size: 14px; color: var(--muted); display: flex; align-items: flex-start; gap: 8px; }\n.rm-body li::before { content: '—'; color: var(--border); flex-shrink: 0; }\n</style>\n</head>\n<body>\n<div class=\"deck\">\n\n<!-- S1: Title -->\n<div class=\"slide active\" id=\"s1\">\n  <div class=\"badge\"><div class=\"dot\"></div> 稼働中</div>\n  <h1>川上 <span class=\"muted\" style=\"font-weight:400;font-size:44px\">成長計画書</span></h1>\n  <div class=\"subtitle\">山下のパーソナル AI パートナー — Claude Code 直結型</div>\n  <div class=\"meta\">\n    <div class=\"meta-item\"><div class=\"meta-value accent\">GCE</div><div class=\"meta-label\">e2-standard-2</div></div>\n    <div class=\"meta-item\"><div class=\"meta-value green\">Claude</div><div class=\"meta-label\">サブスク認証済み</div></div>\n    <div class=\"meta-item\"><div class=\"meta-value\" style=\"color:var(--yellow)\">~$50</div><div class=\"meta-label\">月コスト</div></div>\n    <div class=\"meta-item\"><div class=\"meta-value\" style=\"color:var(--purple)\">24h</div><div class=\"meta-label\">常時稼働</div></div>\n  </div>\n</div>\n\n<!-- S2: Architecture -->\n<div class=\"slide\" id=\"s2\">\n  <div class=\"slide-title\">アーキテクチャ</div>\n  <h2 style=\"margin-bottom:28px\">VM = <span class=\"accent\">常時起動のリモート Claude 端末</span></h2>\n  <div class=\"arch\">\n    <div class=\"arch-row\">\n      <div class=\"arch-box ab-user\">👤 山下<div class=\"sub\">PC / スマホ</div></div>\n    </div>\n    <div class=\"arch-arrow\">↓ make cli（SSH）</div>\n    <div class=\"arch-row\">\n      <div class=\"arch-box ab-claude\" style=\"min-width:280px\">🤖 claude（対話モード）<div class=\"sub\">~/agent で起動 / Claude Code サブスク</div></div>\n    </div>\n    <div class=\"arch-arrow\">↓ 読み書き・Bash 実行</div>\n    <div class=\"arch-row\">\n      <div class=\"arch-box ab-fs\">📄 AGENTS.md<div class=\"sub\">行動定義</div></div>\n      <div class=\"arch-box ab-fs\">📝 DOCS.md<div class=\"sub\">外部記憶</div></div>\n      <div class=\"arch-box ab-fs\">📁 ~/keyaki/<div class=\"sub\">作業リポジトリ</div></div>\n    </div>\n  </div>\n</div>\n\n<!-- S3: Directory -->\n<div class=\"slide\" id=\"s3\">\n  <div class=\"slide-title\">ディレクトリ構成</div>\n  <h2 style=\"margin-bottom:24px\">VM 上の<span class=\"accent\">ファイル配置</span></h2>\n  <div class=\"dir-tree\">\n    <span class=\"c\">~/  (VM: /home/yamashita/)</span><br>\n    ├── <span class=\"link\">AGENTS.md</span> <span class=\"c\">→ ~/agent/AGENTS.md （symlink）</span><br>\n    ├── <span class=\"d\">agent/</span><br>\n    │&nbsp;&nbsp;&nbsp;├── <span class=\"f\">AGENTS.md</span> <span class=\"c\">← 川上の行動定義</span><br>\n    │&nbsp;&nbsp;&nbsp;└── <span class=\"f\">DOCS.md</span> <span class=\"c\">← 外部記憶・作業ログ</span><br>\n    ├── <span class=\"d\">keyaki/</span> <span class=\"c\">← keyaki 作業リポジトリ置き場</span><br>\n    │&nbsp;&nbsp;&nbsp;└── <span class=\"d\">portal/</span><br>\n    ├── <span class=\"d\">reatex/</span> <span class=\"c\">← reatex 業務（兼務・オンデマンド）</span><br>\n    │&nbsp;&nbsp;&nbsp;├── <span class=\"f\">AGENTS.md</span> <span class=\"c\">← reatex 用の行動定義</span><br>\n    │&nbsp;&nbsp;&nbsp;├── <span class=\"f\">DOCS.md</span> <span class=\"c\">← reatex の記憶</span><br>\n    │&nbsp;&nbsp;&nbsp;└── <span class=\"d\">loan-member-site / ax-dashboard / …</span> <span class=\"c\">← rtx リポジトリ</span><br>\n    └── <span class=\"d\">.claude/</span><br>\n    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;└── <span class=\"f\">CLAUDE.md</span> <span class=\"c\">← @~/agent/AGENTS.md を import</span>\n  </div>\n  <p style=\"font-size:13px;color:var(--muted);margin-top:16px\">AGENTS.md / DOCS.md / CLAUDE.md は <code style=\"background:var(--surface);padding:2px 6px;border-radius:4px;font-family:monospace\">make deploy</code> で GitHub から配布</p>\n</div>\n\n<!-- S4: Usage -->\n<div class=\"slide\" id=\"s4\">\n  <div class=\"slide-title\">使い方</div>\n  <h2 style=\"margin-bottom:24px\">SSH で<span class=\"green\">直接対話</span></h2>\n  <div class=\"flow\">\n    <div class=\"flow-step\">\n      <div class=\"flow-num\">1</div>\n      <div class=\"flow-content\">\n        <h3>VM を起動する（停止中の場合）</h3>\n        <p><code>make start</code> で起動。<code>make status</code> で確認。</p>\n      </div>\n    </div>\n    <div class=\"flow-step\">\n      <div class=\"flow-num\">2</div>\n      <div class=\"flow-content\">\n        <h3>川上と接続する</h3>\n        <p><code>make cli</code> で SSH + tmux セッション起動。川上が DOCS.md を読んで前回の文脈を把握してから待機。<br>既存セッションがあれば自動で再接続。</p>\n      </div>\n    </div>\n    <div class=\"flow-step\">\n      <div class=\"flow-num\">3</div>\n      <div class=\"flow-content\">\n        <h3>指示を出す</h3>\n        <p>自然言語で OK。<code>portal のバグを調べて</code> / <code>社内ポータルを作って</code> など。大きな変更は着手前に提案のみ。</p>\n      </div>\n    </div>\n    <div class=\"flow-step\">\n      <div class=\"flow-num\">4</div>\n      <div class=\"flow-content\">\n        <h3>DOCS.md を更新して離席</h3>\n        <p>川上が経緯・決定事項を DOCS.md に記録。<code>Ctrl+B → D</code> で tmux から切り離せば PC シャットダウン後も川上は VM 上で動き続ける。</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- S5: Manual -->\n<div class=\"slide\" id=\"s5\">\n  <div class=\"slide-title\">稼働マニュアル</div>\n  <h2 style=\"margin-bottom:24px\">よく使う<span class=\"accent\">コマンド</span></h2>\n  <div class=\"manual\">\n    <div class=\"manual-card\">\n      <h3>🖥 VM 管理</h3>\n      <div class=\"cmd-list\">\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make start</div><div class=\"cmd-desc\">VM を起動する</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make stop</div><div class=\"cmd-desc\">VM を停止する（課金停止）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make status</div><div class=\"cmd-desc\">VM の状態確認</div></div>\n      </div>\n    </div>\n    <div class=\"manual-card\">\n      <h3>🤝 川上と接続</h3>\n      <div class=\"cmd-list\">\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make cli</div><div class=\"cmd-desc\">keyaki セッション起動（再接続も同じコマンド）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make cli-reatex</div><div class=\"cmd-desc\">reatex セッション起動（兼務・オンデマンド）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make ssh</div><div class=\"cmd-desc\">SSH のみ（生接続）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make deploy</div><div class=\"cmd-desc\">AGENTS.md / DOCS.md / CLAUDE.md を VM に反映</div></div>\n      </div>\n    </div>\n    <div class=\"manual-card\">\n      <h3>💻 ローカルで作業（混雑時）</h3>\n      <div class=\"cmd-list\">\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make pull</div><div class=\"cmd-desc\">サーバーの作業ディレクトリをローカルへ引き取る</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make push</div><div class=\"cmd-desc\">ローカルの作業をサーバーへ戻す（DOCS.md 除外）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make pull-dry / push-dry</div><div class=\"cmd-desc\">転送差分のプレビュー（--dry-run）</div></div>\n      </div>\n      <p style=\"font-size:12px;color:var(--muted);margin-top:12px\">VM が混んだら <code style=\"background:var(--surface);padding:2px 6px;border-radius:4px;font-family:monospace\">~/Documents/repos/keyaki/server-share/</code> へ引き取って作業 → 戻す方式。node_modules は除外転送なので pull 後に <code style=\"background:var(--surface);padding:2px 6px;border-radius:4px;font-family:monospace\">npm install</code> で復元。同一 repo をサーバーと同時編集しない。</p>\n    </div>\n    <div class=\"manual-card\">\n      <h3>📺 tmux 操作</h3>\n      <div class=\"cmd-list\">\n        <div class=\"cmd-row\"><div class=\"cmd-code\">Ctrl+B → D</div><div class=\"cmd-desc\">セッションから切り離す（VM は動き続ける）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">Ctrl+B → [</div><div class=\"cmd-desc\">スクロールモード（Q で終了）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">tmux ls</div><div class=\"cmd-desc\">セッション一覧（VM 内で）</div></div>\n      </div>\n    </div>\n    <div class=\"manual-card\">\n      <h3>📂 重要ファイル（GitHub 管理）</h3>\n      <div class=\"cmd-list\">\n        <div class=\"cmd-row\"><div class=\"cmd-code\">agent/AGENTS.md</div><div class=\"cmd-desc\">川上の行動定義</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">agent/DOCS.md</div><div class=\"cmd-desc\">外部記憶・作業ログ</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">claude/CLAUDE.md</div><div class=\"cmd-desc\">~/.claude/CLAUDE.md として配布</div></div>\n      </div>\n    </div>\n    <div class=\"manual-card\">\n      <h3>⚙️ 初回セットアップ</h3>\n      <div class=\"cmd-list\">\n        <div class=\"cmd-row\"><div class=\"cmd-code\">bash setup.sh</div><div class=\"cmd-desc\">Node.js + claude CLI インストール</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">claude auth login</div><div class=\"cmd-desc\">サブスクで認証（VM 上で一度だけ）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-code\">make deploy</div><div class=\"cmd-desc\">設定ファイルを VM に配布</div></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- S6: Roadmap -->\n<div class=\"slide\" id=\"s6\">\n  <div class=\"slide-title\">ロードマップ</div>\n  <h2 style=\"margin-bottom:28px\">川上の<span class=\"purple\">成長計画</span></h2>\n  <div class=\"roadmap\">\n    <div class=\"rm-phase\">\n      <div class=\"rm-dot active\">1</div>\n      <div class=\"rm-body\">\n        <h3>Phase 1 — SSH 直接セッション <span class=\"rm-tag tag-now\">現在</span></h3>\n        <ul>\n          <li>make cli → SSH → claude 対話</li>\n          <li>DOCS.md でセッション間の記憶を引き継ぎ</li>\n          <li>PC が閉じていても VM は稼働し続ける</li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"rm-phase\">\n      <div class=\"rm-dot next\">2</div>\n      <div class=\"rm-body\">\n        <h3>Phase 2 — Slack 非同期コミュニケーション <span class=\"rm-tag tag-next\">次のステップ</span></h3>\n        <ul>\n          <li>Slack DM → VM で claude -p を自動実行</li>\n          <li>claude が Slack に自分で返信</li>\n          <li>スマホからも指示を出せる</li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"rm-phase\">\n      <div class=\"rm-dot future\">3</div>\n      <div class=\"rm-body\">\n        <h3>Phase 3 — 完全自律稼働 <span class=\"rm-tag tag-future\">将来</span></h3>\n        <ul>\n          <li>定期スキャン → 改善提案・自動 PR</li>\n          <li>GitHub Actions・CI 連携</li>\n          <li>寝てる間に PR が溜まってる</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- S7: reatex 兼務 -->\n<div class=\"slide\" id=\"s7\">\n  <div class=\"slide-title\">業務の兼務</div>\n  <h2 style=\"margin-bottom:24px\">川上は <span class=\"accent\">reatex 業務</span> も兼務する</h2>\n  <div class=\"manual\" style=\"max-width:900px\">\n    <div class=\"manual-card\">\n      <h3>🟦 keyaki 業務 — <code style=\"color:var(--accent)\">~/agent</code></h3>\n      <div class=\"cmd-list\">\n        <div class=\"cmd-row\"><div class=\"cmd-desc\">起動: <code>make cli</code></div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-desc\">報告先: <span class=\"accent\">Slack</span></div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-desc\">GitHub: keyaki-dev アカウント</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-desc\">作業: ~/keyaki 配下のリポジトリ</div></div>\n      </div>\n    </div>\n    <div class=\"manual-card\">\n      <h3>🟨 reatex 業務 — <code style=\"color:var(--yellow)\">~/reatex</code></h3>\n      <div class=\"cmd-list\">\n        <div class=\"cmd-row\"><div class=\"cmd-desc\">起動: <code>make cli-reatex</code>（オンデマンド）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-desc\">報告先: <span class=\"yellow\">LINE WORKS</span>（useai-studio MCP）</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-desc\">GitHub: rtx-yamashita アカウント</div></div>\n        <div class=\"cmd-row\"><div class=\"cmd-desc\">作業: ~/reatex 配下の rtx リポジトリ</div></div>\n      </div>\n    </div>\n  </div>\n  <p style=\"font-size:13px;color:var(--muted);margin-top:20px;max-width:820px;text-align:center\">\n    ディレクトリで人格を切り替える方式。<code style=\"background:var(--surface);padding:2px 6px;border-radius:4px;font-family:monospace\">~/reatex/AGENTS.md</code> が reatex 用の行動を定義し、GitHub アカウント・報告先・MCP（useai-studio / google-drive）を keyaki と混ぜない。\n    脳の更新は <code style=\"background:var(--surface);padding:2px 6px;border-radius:4px;font-family:monospace\">make deploy-reatex</code>、認証情報の転送は <code style=\"background:var(--surface);padding:2px 6px;border-radius:4px;font-family:monospace\">make push-secrets-reatex</code>。\n  </p>\n</div>\n\n</div>\n<div id=\"nav\">\n  <button id=\"prev\">←</button>\n  <span id=\"page-indicator\">1 / 7</span>\n  <button id=\"next\">→</button>\n</div>\n<script>\nconst slides = document.querySelectorAll('.slide')\nconst total = slides.length\nlet current = 0\nfunction go(n) {\n  slides[current].classList.remove('active')\n  current = (n + total) % total\n  slides[current].classList.add('active')\n  document.getElementById('page-indicator').textContent = `${current + 1} / ${total}`\n}\ndocument.getElementById('prev').addEventListener('click', () => go(current - 1))\ndocument.getElementById('next').addEventListener('click', () => go(current + 1))\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'ArrowRight' || e.key === 'ArrowDown') go(current + 1)\n  if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') go(current - 1)\n})\n</script>\n</body>\n</html>\n"}